# MongoDB connection string. Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/
# Local: run `just mongo` and use mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
# Database name inside the cluster.
MONGODB_DB=travel_planner
# Bearer token every API caller (the web app and AI agents) must send.
API_TOKEN=change-me
# Where the web app reaches the API.
API_URL=http://localhost:8000
# The web app's origin, allowed by CORS (comma-separate several).
WEB_ORIGIN=http://localhost:3001
# Fetch a preview (title, image, icon) when a link is pinned. Set to false to never fetch.
LINK_PREVIEWS=true
