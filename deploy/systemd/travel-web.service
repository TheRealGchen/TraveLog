# Rendered to /etc/systemd/system/travel-web.service by `just provision`.
[Unit]
Description=Travel Planner web app (Next.js)
After=network-online.target travel-api.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/apps/web
EnvironmentFile=__REPO__/.env
Environment=NODE_ENV=production
ExecStart=__NODE__ __REPO__/apps/web/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port __WEB_PORT__
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
